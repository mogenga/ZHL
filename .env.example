# ZHL · 本地 PostgreSQL 15（Docker）
# 用法：.env 由开发机本地维护，不提交；.env.example 为可提交模板
# 与 compose.yaml / alembic.ini 凭据一致。

# --- 数据库 ---
ZHL_DB=zhl
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=15432

# 应用连接串（SQLAlchemy 2.0 / psycopg；langgraph-checkpoint-postgres 同源）
ZHL_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:15432/zhl

# --- 证据文件根目录（相对项目根；compose / 容器内为 /data）---
ZHL_EVIDENCE_ROOT=data/evidence

# --- LLM（可插拔 LLMClient；测试/演示用 MockLLMClient 不需要真实 key）---
# 三个都填才会启用真实模型；只填 KEY 或留空一律回落到 fixture mock。
# 注意：base_url 必须是 OpenAI Chat Completion 协议端点。
#   DeepSeek : https://api.deepseek.com
#   智谱 GLM : https://open.bigmodel.cn/api/paas/v4
#   智谱 Coding Plan 套餐 key 需换成 https://open.bigmodel.cn/api/coding/paas/v4
# 不要填 /anthropic 结尾的地址 —— 那是 Anthropic Messages 协议，与本客户端不兼容。
# ZHL_LLM_API_KEY=
# ZHL_LLM_BASE_URL=https://api.deepseek.com
# ZHL_LLM_MODEL=deepseek-v4-flash

# --- 工作流检查点 ---
# memory（默认，进程重启后人工待办丢失）| pg（复用上面的 ZHL_DATABASE_URL持久化）
# ZHL_CHECKPOINTER=pg
