# ZHL · 本地 PostgreSQL 15（Docker）
# 用法：.env 由开发机本地维护，不提交；.env.example 为可提交模板
# 与 compose.yaml / alembic.ini 凭据一致。

# --- 数据库 ---
ZHL_DB=zhl
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=15432

# 应用连接串（SQLAlchemy 2.0 / psycopg；langgraph-checkpoint-postgres 同源）
ZHL_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:15432/zhl

# --- 证据文件根目录（相对项目根；compose / 容器内为 /data）---
ZHL_EVIDENCE_ROOT=data/evidence

# --- LLM（可插拔 LLMClient；测试/演示用 MockLLMClient 不需要真实 key）---
# ZHL_LLM_API_KEY=
# ZHL_LLM_BASE_URL=https://api.openai.com/v1
# ZHL_LLM_MODEL=gpt-4o-mini
